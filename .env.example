# Anthropic (required)
ANTHROPIC_API_KEY=sk-ant-...

# Kalshi API (optional — for live trading)
# Generate at https://kalshi.com/settings/api
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=  # path to RSA PEM private key file
# KALSHI_DEMO=true  # uncomment to use demo environment

# Twitter API v2 (optional — real-time news stream)
TWITTER_BEARER_TOKEN=

# Telegram Bot (optional — channel monitoring)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_IDS=

# NewsAPI.org (optional — broader news coverage)
NEWSAPI_KEY=

# Pipeline Settings
DRY_RUN=true
MAX_BET_USD=25
DAILY_LOSS_LIMIT_USD=100
EDGE_THRESHOLD=0.10

# V2 Settings
MAX_VOLUME_USD=500000
MIN_VOLUME_USD=1000
MATERIALITY_THRESHOLD=0.6
SPEED_TARGET_SECONDS=5
